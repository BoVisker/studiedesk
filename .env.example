# Publieke Supabase-waarden (mogen in de frontend; beveiliging komt uit RLS).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable/anon key>

# Alleen nodig voor lokale builds onder een subpad; de GitHub-workflow zet dit zelf.
# VITE_BASE=/studiedesk/

# Feature flags (fase 6+). Magister blijft uit.
VITE_FEATURE_MAGISTER=false
VITE_FEATURE_GOOGLE_LOGIN=false

# LET OP: Anthropic- en YouTube-keys horen hier NOOIT.
# Die staan als Supabase secrets (zie README).
